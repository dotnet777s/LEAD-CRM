# Copie para .env (NÃO versionar). Sem valores reais aqui.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=leads.topcarpe.site
# Postgres do Neon (mesmo banco do estoque). Sem isso usa SQLite local.
DATABASE_URL=

# Meta (Pixel + Conversions API)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=0

# Backblaze B2 (fotos do estoque, somente leitura)
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
B2_ENDPOINT=
B2_REGION=

# Loja
LOJA_WHATSAPP=5581960002209
SITE_URL=https://leads.topcarpe.site

# Telegram (bot criado no @BotFather). Worker: python manage.py telegram_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=leadsreceiverbot
TELEGRAM_SLA_MINUTOS=5
