# A Cloudflare fica na frente: ela entrega o HTTPS ao visitante e fala com este servidor em HTTP (modo "Flexible").
# Por isso o site é "http://" aqui (sem pedir certificado). Para criptografar também o trecho Cloudflare -> servidor,
# gere um "Origin Certificate" na Cloudflare, use `tls cert.pem chave.pem` neste bloco e troque o modo para "Full (strict)".
http://__DOMINIO__ {
	encode zstd gzip

	# o app serve os próprios arquivos estáticos (WhiteNoise)
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
