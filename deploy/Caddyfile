# Este servidor fica atrás da Cloudflare (que entrega o HTTPS ao visitante e fala com cá em HTTP, modo "Flexible").
# Aceita qualquer Host: o Django valida o host (ALLOWED_HOSTS) e usa SITE_URL para as URLs públicas.
# Para criptografar também o trecho Cloudflare -> servidor: gere um "Origin Certificate" na Cloudflare,
# troque `:80` por `__DOMINIO__` com `tls cert.pem chave.pem` e mude o modo SSL para "Full (strict)".
:80 {
	encode zstd gzip

	# o app serve os próprios arquivos estáticos (WhiteNoise)
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
