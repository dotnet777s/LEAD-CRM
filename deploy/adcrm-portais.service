[Unit]
Description=ADCRM - leitura dos leads dos portais por e-mail (IMAP)
After=network-online.target
Wants=network-online.target

[Service]
User=adcrm
Group=adcrm
WorkingDirectory=/opt/adcrm
ExecStart=/opt/adcrm/.venv/bin/python manage.py ler_portais --loop --intervalo 60
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
