# Modelo do /opt/adcrm/.env no servidor. NUNCA versionar o arquivo real.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=contato.topcarpe.com.br
SITE_URL=https://contato.topcarpe.com.br

# Neon do ROUTE. Estoque (schema public, só leitura) + leads do CRM (schema crm).
# Use o usuário crm_app (docs/neon_acesso_crm.sql). Conexão direta (sem "-pooler") para o search_path funcionar:
# postgresql://crm_app:SENHA@ep-silent-mountain-b6qlbsef.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&options=-c%20search_path%3Dcrm%2Cpublic
DATABASE_URL=

# Meta (Pixel + Conversions API)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=0

# Loja
LOJA_WHATSAPP=5581960002209

# Telegram (@BotFather). Use o token NOVO (revogue o antigo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=leadsreceiverbot
TELEGRAM_SLA_MINUTOS=5

# Leads dos portais (Napista, Mobiauto, OLX) por e-mail. Caixa dedicada, ex.: leads@topcarpe.com.br. Vazio = desligado.
PORTAIS_IMAP_HOST=
PORTAIS_IMAP_PORTA=993
PORTAIS_IMAP_USER=
PORTAIS_IMAP_PASS=
PORTAIS_IMAP_PASTA=INBOX
# Portais ativos (por enquanto só a OLX)
PORTAIS_ATIVOS=olx
