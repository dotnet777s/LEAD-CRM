[Unit]
Description=ADCRM - worker da Conversions API da Meta
After=network-online.target
Wants=network-online.target

[Service]
User=adcrm
Group=adcrm
WorkingDirectory=/opt/adcrm
ExecStart=/opt/adcrm/.venv/bin/python manage.py enviar_eventos_meta --loop --intervalo 5
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
